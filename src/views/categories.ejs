<main>
    <%- include('partials/header') %>
    <h1><%= title %></h1>

    <section class="categories">
        <ul>
            <% categories.forEach(category => { %>
                <li><a href="/category/<%= category.category_id %>">
                    <%= category.category_name %></a></li>
            <% }); %>
        </ul>
    </section>
</main>
<%- include('partials/footer') %>