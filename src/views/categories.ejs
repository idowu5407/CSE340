<%- include('partials/header') %>
<main>   
  <h1><%= title %></h1>

  <!-- New Category button -->
  <div class="actions">
     <% if (user && user.role_name === 'admin') { %>
      <a href="/new-category" class="full-button">Add a New Category</a>
    <% } %>
  </div>

  <!-- Categories list -->
  <section class="categories">
    <ul class="category-list">
      <% categories.forEach(category => { %>
        <li>
          <span><%= category.category_name %></span>
          <% if (user && user.role_name === 'admin') { %>
            <a href="/edit-category/<%= category.category_id %>">Edit</a>
          <% } %>
        </li>
      <% }); %>
    </ul>
  </section>
</main>
<%- include('partials/footer') %>
