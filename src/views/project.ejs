 <%- include('partials/header') %>
<main>
  <h1><%= title %></h1>
   
  <h2><%= project.title %></h2>
  <p><%= project.description %></p>
  <p>Date: <%= new Date(project.date).toLocaleDateString('en-US', { 
    year: 'numeric', month: 'long', day: 'numeric' 
  }) %></p>
  <p>Location: <%= project.location %></p>
  <p>
    Organization: 
    <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
  </p>

  <h3>Categories</h3>
  <div>
    <% categories.forEach(category => { %>
      <a href="/category/<%= category.category_id %>"><%= category.category_name %></a>
    <% }) %>
  </div>
  <div></div>
    <% if (user && user.role_name === 'admin') { %>
      <li><a href="/edit-project/<%= project.project_id %>">Edit Project</a></li>
      <li><a href="/project/<%= project.project_id %>/assign-categories">Edit Categories</a></li>
    <% } %>
  </div>
  <a href="/projects" class="full-button">Back to Projects</a>
</main>
<%- include('partials/footer') %>

