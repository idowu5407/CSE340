<h1><%= project.title %></h1>
<p><%= project.description %></p>
<p>Date: <%= new Date(project.date).toLocaleDateString('en-US', { 
  year: 'numeric', month: 'long', day: 'numeric' 
}) %></p>
<p>Location: <%= project.location %></p>
<p>
  Organization: 
  <a href="/organizations/<%= project.organization_id %>"><%= project.organization_name %></a>
</p>

<a href="/projects">Back to Projects</a>
